{
  "name": "oil-hose",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",

  // public/ is the site root: index.html, /assets, /images, robots.txt,
  // plus _headers, which Workers applies natively.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* reaches the Worker; static files are served without invoking it.
    "run_worker_first": ["/api/*"]
  },

  // Plain-text config lives here: every deploy replaces the Worker's vars with this
  // block, so values set only in the dashboard are wiped on the next push.
  // RESEND_API_KEY stays a dashboard secret (secrets survive deploys).
  "vars": {
    // Must be on a domain verified in Resend (tubes-international.online).
    "MAIL_FROM": "Заявки з сайту <lead@tubes-international.online>",
    // Test mode: every lead goes here instead of the city branch.
    // Remove to restore branch routing (lviv@ / kyiv@ / dnipro@).
    "MAIL_TO": "tubes.marketing.ua@gmail.com"
  },

  "observability": {
    "enabled": true
  }
}
