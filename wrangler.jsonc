{
  "name": "oil-hose",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",

  // public/ is the site root: index.html, /assets, /images, robots.txt,
  // plus _headers, which Workers applies natively.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* reaches the Worker; static files are served without invoking it.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
